<Window x:Class="ShortcutStudio.TrophyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Emulator trophies" Width="720" Height="560" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Panel}" ResizeMode="CanResizeWithGrip" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <DockPanel Margin="18">
        <TextBlock DockPanel.Dock="Top" Text="Use an emulator's trophies as achievements" Style="{StaticResource SectionTitle}"/>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Dim}" Margin="0,4,0,12"
                   Text="Supports RPCS3 (PS3), shadPS4 (PS4) and native PC ports built on ps3recomp. The trophy list, icons and grades are imported, and from then on trophies you earn in the emulator unlock in Steam on their own, with a popup."/>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="Look in another folder…" Click="Browse_Click"/>
            <TextBlock x:Name="Searched" Style="{StaticResource Dim}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
        </DockPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0"/>
            <Button x:Name="ImportBtn" Content="Import and sync" Style="{StaticResource Primary}" Click="Import_Click" IsEnabled="False" Padding="18,6"/>
        </StackPanel>

        <Grid>
            <ListBox x:Name="Sets" SelectionChanged="Sets_Changed" MouseDoubleClick="Sets_DoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,3">
                            <Border Width="56" Height="56" Background="#10141A" Margin="0,0,12,0" CornerRadius="2" ClipToBounds="True">
                                <Image Source="{Binding Icon}" Stretch="UniformToFill"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Line1}" Style="{StaticResource Dim}"/>
                                <TextBlock Text="{Binding Line2}" FontSize="11" Foreground="#6E9AC0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="Message" Style="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="460"/>
        </Grid>
    </DockPanel>
</Window>
