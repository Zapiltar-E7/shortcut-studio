<Window x:Class="ShortcutStudio.RaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RetroAchievements" Width="680" Height="620" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Panel}" ResizeMode="CanResizeWithGrip" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <DockPanel Margin="18">
        <TextBlock DockPanel.Dock="Top" Text="Use a RetroAchievements set" Style="{StaticResource SectionTitle}"/>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Dim}" Margin="0,4,0,12"
                   Text="Imports the set's achievements with their badges, points and global unlock rates, plus what you've already earned. While the game runs through Steam, new unlocks are picked up from RetroAchievements about once a minute."/>
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="ConsoleBox" Height="32" SelectionChanged="Console_Changed"/>
            <TextBox Grid.Column="2" x:Name="Query" FontSize="14" TextChanged="Query_Changed"/>
        </Grid>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0"/>
            <Button x:Name="ImportBtn" Content="Import and sync" Style="{StaticResource Primary}" Click="Import_Click" IsEnabled="False" Padding="18,6"/>
        </StackPanel>
        <Grid Margin="0,12,0,0">
            <ListBox x:Name="Results" SelectionChanged="Results_Changed" MouseDoubleClick="Results_DoubleClick" VirtualizingPanel.IsVirtualizing="True">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,2">
                            <Border Width="40" Height="40" Background="#10141A" Margin="0,0,12,0" CornerRadius="2" ClipToBounds="True">
                                <Image Source="{Binding IconUrl}" Stretch="UniformToFill"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Dim}">
                                    <Run Text="{Binding NumAchievements, Mode=OneWay}"/> achievements · game <Run Text="{Binding Id, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="Message" Style="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="440"/>
        </Grid>
    </DockPanel>
</Window>
