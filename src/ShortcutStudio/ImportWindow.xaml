<Window x:Class="ShortcutStudio.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import from Steam" Width="640" Height="620" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Panel}" ResizeMode="CanResizeWithGrip" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <DockPanel Margin="18">
        <TextBlock DockPanel.Dock="Top" Text="Copy an official Steam game" Style="{StaticResource SectionTitle}"/>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Dim}" Margin="0,4,0,12"
                   Text="Search the Steam store by name, or type an appid. The game's library art, store details and achievement list are copied onto this shortcut."/>
        <DockPanel DockPanel.Dock="Top">
            <Button DockPanel.Dock="Right" Content="Search" Style="{StaticResource Primary}" Margin="6,0,0,0" Click="Search_Click" IsDefault="True"/>
            <TextBox x:Name="Query" FontSize="14"/>
        </DockPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock Text="IMPORT" Style="{StaticResource Label}"/>
            <WrapPanel>
                <CheckBox x:Name="ChkArt" Content="Artwork" IsChecked="True" Margin="0,0,18,0"/>
                <CheckBox x:Name="ChkDetails" Content="Description and details" IsChecked="True" Margin="0,0,18,0"/>
                <CheckBox x:Name="ChkAch" Content="Achievements" IsChecked="True" Margin="0,0,18,0"/>
                <CheckBox x:Name="ChkName" Content="Name" IsChecked="True"/>
            </WrapPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0"/>
                <Button x:Name="ImportBtn" Content="Import" Style="{StaticResource Primary}" Click="Import_Click" IsEnabled="False" Padding="18,6"/>
            </StackPanel>
        </StackPanel>

        <Grid Margin="0,12,0,0">
            <ListBox x:Name="Results" SelectionChanged="Results_Changed" MouseDoubleClick="Results_DoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,2">
                            <Border Width="120" Height="45" Background="#10141A" Margin="0,0,12,0" CornerRadius="2" ClipToBounds="True">
                                <Image Source="{Binding ImageUrl}" Stretch="UniformToFill"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding AppId, StringFormat=App {0}}" Style="{StaticResource Dim}"/>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="Message" Style="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </DockPanel>
</Window>
